# Copy to .env (which is in .gitignore).
# The scripts load .env themselves (scripts/config.mjs), no dotenv needed.

# ---------- Destination ----------
DESTINATION_NAME=SA1_300
SAP_CLIENT=300

# The transport is picked automatically:
#   - if @sap-cloud-sdk/connectivity + /http-client are installed -> Cloud SDK
#   - otherwise -> the built-in fallback (zero dependencies)
# Force one: TRANSPORT=cloud-sdk or TRANSPORT=builtin
# TRANSPORT=

# --- Running on BTP (Cloud Foundry) ---
# Nothing else needed: VCAP_SERVICES with a destination binding (+ connectivity
# for OnPremise destinations) is read automatically by both transports.

# --- Running locally, option 1 (same format as the business-partner-ai project) ---
# Cloud SDK reads the `destinations` variable; the fallback supports it too. One line:
# destinations=[{"name":"SA1_300","url":"https://host:44300","username":"USER","password":"PASS"}]

# --- Running locally, option 2 (built-in fallback only) ---
# SA1_URL=https://host:44300
# SA1_USER=USER
# SA1_PASSWORD=PASS
# SA1_PROXY=http://proxy.company.local:8080

# ---------- Source: the service whose $metadata we read ----------
SOURCE_SERVICE_NAME=API_BUSINESS_PARTNER
SOURCE_SERVICE_PATH=/sap/opu/odata/sap/API_BUSINESS_PARTNER

# ---------- Target: your tool repository on SA1 ----------
# REQUIRED: you must set it explicitly (even when the value matches the
# default below) - post-tools.mjs refuses to send anything until this
# variable is set in .env, so you don't accidentally POST to an unverified path.
TOOL_REPO_SERVICE_PATH=/sap/opu/odata/sap/ZXXXX_KPI_SRV
TOOL_REPO_ENTITYSET=ToolSet

# ---------- Generation scope ----------
ENTITY_SETS=A_BusinessPartner,A_Customer,A_Supplier
GEN_READ_BY_KEY=true
GEN_LIST=true
GEN_NAVIGATION=true
MAX_FILTER_PARAMS=5
MAX_SELECT_FIELDS=6
FILTER_TEMPLATE_STYLE=placeholders   # placeholders | none

# ---------- OpenAI ----------
# OPENAI_API_KEY / OPENAI_MODEL are shared by two independent uses:
#
# 1) scripts/generate-tools.mjs - descriptions (ToolDesc/ParamDesc). Template-
#    based by default (offline, from toolgen.mjs). Set
#    USE_OPENAI_DESCRIPTIONS=true to have them overwritten by OpenAI-generated
#    descriptions (one request per tool). Still nothing is sent to SAP - the
#    result is loaded into out/tools.json and reviewed before post-tools.mjs.
#
# 2) srv/AgentService.js (CAP, runs under cds watch / on BTP) - a LangChain
#    agent that answers queries (`POST .../agent/ask`) and can call tools
#    loaded from the SA1_300 repository while doing so. REQUIRES a real
#    OPENAI_API_KEY to work at all (there is no offline mode for it).
USE_OPENAI_DESCRIPTIONS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- DDIC field length limits (match these to your tables!) ----------
LIMIT_TOOL_NAME=40
LIMIT_TOOL_DESC=255
LIMIT_SELECT_FIELDS=255
LIMIT_FILTER_TEMPLATE=255
LIMIT_PARAM_NAME=40
LIMIT_PARAM_DESC=255

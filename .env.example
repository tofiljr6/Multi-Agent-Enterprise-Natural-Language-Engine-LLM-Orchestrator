# Skopiuj do .env (jest w .gitignore).
# Skrypty laduja .env same (scripts/config.mjs), nie potrzeba dotenv.

# ---------- Destination ----------
DESTINATION_NAME=SA1_300
SAP_CLIENT=300

# Transport wybiera sie automatycznie:
#   - jesli sa zainstalowane @sap-cloud-sdk/connectivity + /http-client -> Cloud SDK
#   - w przeciwnym razie -> wbudowany fallback (zero zaleznosci)
# Wymuszenie: TRANSPORT=cloud-sdk albo TRANSPORT=builtin
# TRANSPORT=

# --- Uruchomienie w BTP (Cloud Foundry) ---
# Nic wiecej nie trzeba: VCAP_SERVICES z bindingiem destination (+ connectivity dla OnPremise)
# jest czytane automatycznie przez oba transporty.

# --- Uruchomienie lokalne, wariant 1 (ten sam format co w projekcie business-partner-ai) ---
# Cloud SDK czyta zmienna `destinations`; fallback rowniez ja obsluguje. Jedna linia:
# destinations=[{"name":"SA1_300","url":"https://host:44300","username":"USER","password":"PASS"}]

# --- Uruchomienie lokalne, wariant 2 (tylko fallback wbudowany) ---
# SA1_URL=https://host:44300
# SA1_USER=USER
# SA1_PASSWORD=PASS
# SA1_PROXY=http://proxy.firma.local:8080

# ---------- Zrodlo: serwis, z ktorego czytamy $metadata ----------
SOURCE_SERVICE_NAME=API_BUSINESS_PARTNER
SOURCE_SERVICE_PATH=/sap/opu/odata/sap/API_BUSINESS_PARTNER

# ---------- Cel: Twoj tool repository na SA1 ----------
# WYMAGANE: musisz ja jawnie ustawic (nawet gdy wartosc pokrywa sie z domyslna
# ponizej) - post-tools.mjs odmawia wysylki, dopoki ta zmienna nie jest
# ustawiona w .env, zeby nie POST-owac przypadkiem na niesprawdzona sciezke.
TOOL_REPO_SERVICE_PATH=/sap/opu/odata/sap/ZXXXX_KPI_SRV
TOOL_REPO_ENTITYSET=ToolSet

# ---------- Zakres generowania ----------
ENTITY_SETS=A_BusinessPartner,A_Customer,A_Supplier
GEN_READ_BY_KEY=true
GEN_LIST=true
GEN_NAVIGATION=true
MAX_FILTER_PARAMS=5
MAX_SELECT_FIELDS=6
FILTER_TEMPLATE_STYLE=placeholders   # placeholders | none

# ---------- Opisy (ToolDesc / ParamDesc) przez OpenAI ----------
# Domyslnie opisy sa szablonowe (offline, deterministyczne, z toolgen.mjs).
# Ustaw USE_OPENAI_DESCRIPTIONS=true, zeby generate-tools.mjs nadpisal je
# opisami z OpenAI (jeden request na narzedzie, model widzi cale narzedzie
# + wszystkie jego parametry naraz). Nadal nic nie jest wysylane do SAP -
# wynik ladujesz do out/tools.json i przegladasz przed post-tools.mjs.
USE_OPENAI_DESCRIPTIONS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Limity dlugosci pol w DDIC (dopasuj do swoich tabel!) ----------
LIMIT_TOOL_NAME=40
LIMIT_TOOL_DESC=255
LIMIT_SELECT_FIELDS=255
LIMIT_FILTER_TEMPLATE=255
LIMIT_PARAM_NAME=40
LIMIT_PARAM_DESC=255
